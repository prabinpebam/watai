  "transitionDefaults":{"requiredGuards":["valid-envelope","current-lease","current-source"],"commit":"candidate-partition-cas-with-event-and-outbox"},
  "transitions":[
    {"from":["QUEUED"],"event":"dispatch","to":"PREFLIGHT","actor":"controller","guards":["budget-reserved"],"effect":"preflight"},
    {"from":["PREFLIGHT"],"event":"preflight_passed","to":"SPEC_LOCKED","actor":"release-verifier","guards":["capabilities-proven","spec-pinned"],"effect":"none"},
    {"from":["SPEC_LOCKED"],"event":"start_build","to":"BUILDING","actor":"controller","guards":["budget-reserved","attempts-remaining"],"effect":"worker"},
    {"from":["BUILDING"],"event":"patch_submitted","to":"VALIDATING","actor":"builder","guards":["spec-pinned"],"effect":"validation"},
    {"from":["VALIDATING"],"event":"validation_passed","to":"ADVERSARIAL","actor":"evaluator","guards":["independent-evidence","gates-passed"],"effect":"adversaries"},
    {"from":["ADVERSARIAL"],"event":"review_passed","to":"STAGING","actor":"release-verifier","guards":["adversaries-complete","gates-passed"],"effect":"stage"},
    {"from":["STAGING"],"event":"stage_passed","to":"RELEASE_READY","actor":"release-verifier","guards":["stage-contract","independent-evidence","gates-passed"],"effect":"none"},
    {"from":["RELEASE_READY"],"event":"permit_issued","to":"PROMOTING","actor":"release-verifier","guards":["permit-current","gates-passed","lkg-admissible","budget-reserved","cohort-scope","new-single-use-permit"],"effect":"promote"},
    {"from":["PROMOTING"],"event":"route_committed","to":"OBSERVING","actor":"release-broker","guards":["route-reconciled"],"effect":"observe"},
    {"from":["OBSERVING"],"event":"cohort_passed","to":"EXPANSION_READY","actor":"evaluator","guards":["cohort-observation-passed","independent-evidence"],"effect":"none"},
    {"from":["EXPANSION_READY"],"event":"expansion_permit_issued","to":"EXPANDING","actor":"release-verifier","guards":["permit-current","full-scope","new-single-use-permit","gates-passed"],"effect":"expand"},
    {"from":["EXPANDING"],"event":"expansion_committed","to":"FINAL_OBSERVING","actor":"release-broker","guards":["route-reconciled"],"effect":"observe"},
    {"from":["FINAL_OBSERVING"],"event":"observation_passed","to":"SHIPPED","actor":"evaluator","guards":["observation-passed","independent-evidence"],"effect":"none"},
    {"from":["PREFLIGHT","SPEC_LOCKED","BUILDING","VALIDATING","ADVERSARIAL","STAGING","RELEASE_READY"],"event":"step_failed","to":"FAILED","actor":"evaluator","guards":["no-public-effects"],"effect":"cancel-children"},
    {"from":["QUEUED","PREFLIGHT","SPEC_LOCKED","BUILDING","VALIDATING","ADVERSARIAL","STAGING","RELEASE_READY"],"event":"deadline","to":"TIMED_OUT","actor":"watchdog","guards":["deadline-exceeded","no-public-effects"],"effect":"cancel-children"},
    {"from":["FAILED","TIMED_OUT"],"event":"retry","to":"SPEC_LOCKED","actor":"controller","guards":["attempts-remaining","budget-remaining","effects-reconciled","no-public-effects"],"effect":"backoff"},
    {"from":["FAILED"],"event":"exhausted","to":"REJECTED","actor":"watchdog","guards":["attempts-exhausted","effects-reconciled","no-public-effects"],"effect":"none"},
    {"from":["TIMED_OUT"],"event":"exhausted","to":"BLOCKED_SAFE","actor":"watchdog","guards":["attempts-exhausted"],"effect":"freeze"},
    {"from":["QUEUED","PREFLIGHT","SPEC_LOCKED","BUILDING","VALIDATING","ADVERSARIAL","STAGING","RELEASE_READY","FAILED","TIMED_OUT"],"event":"capability_missing","to":"BLOCKED_SAFE","actor":"watchdog","guards":["authority-missing","no-public-effects"],"effect":"freeze"},
    {"from":["QUEUED","PREFLIGHT","SPEC_LOCKED","BUILDING","VALIDATING","ADVERSARIAL","STAGING","RELEASE_READY","PROMOTING","OBSERVING","EXPANSION_READY","EXPANDING","FINAL_OBSERVING","FAILED","TIMED_OUT"],"event":"cancel","to":"CANCEL_REQUESTED","actor":"watchdog","guards":["cancel-authorized"],"effect":"cancel-children"},
    {"from":["CANCEL_REQUESTED"],"event":"cancel_reconciled","to":"CANCELLED","actor":"watchdog","guards":["effects-reconciled","no-public-effects"],"effect":"none"},
    {"from":["CANCEL_REQUESTED","QUARANTINED"],"event":"withdraw","to":"ROLLING_BACK","actor":"release-verifier","guards":["public-effects-possible","lkg-admissible"],"effect":"rollback"},
    {"from":["QUEUED","PREFLIGHT","SPEC_LOCKED","BUILDING","VALIDATING","ADVERSARIAL","STAGING","RELEASE_READY","PROMOTING","OBSERVING","EXPANSION_READY","EXPANDING","FINAL_OBSERVING","FAILED","TIMED_OUT","CANCEL_REQUESTED"],"event":"tamper","to":"QUARANTINED","actor":"release-verifier","guards":["integrity-fault"],"effect":"freeze"},
    {"from":["QUARANTINED"],"event":"reject","to":"REJECTED","actor":"release-verifier","guards":["effects-reconciled","no-public-effects"],"effect":"none"},
    {"from":["PROMOTING","OBSERVING","EXPANSION_READY","EXPANDING","FINAL_OBSERVING"],"event":"release_failed","to":"ROLLING_BACK","actor":"release-verifier","guards":["public-effects-possible","lkg-admissible"],"effect":"rollback"},
    {"from":["PROMOTING","OBSERVING","EXPANSION_READY","EXPANDING","FINAL_OBSERVING"],"event":"deadline","to":"ROLLING_BACK","actor":"watchdog","guards":["deadline-exceeded","lkg-admissible"],"effect":"rollback"},
    {"from":["ROLLING_BACK"],"event":"rollback_passed","to":"ROLLED_BACK","actor":"release-broker","guards":["rollback-confirmed","effects-reconciled"],"effect":"none"},
    {"from":["PROMOTING","OBSERVING","EXPANSION_READY","EXPANDING","FINAL_OBSERVING","ROLLING_BACK","CANCEL_REQUESTED","QUARANTINED"],"event":"recovery_blocked","to":"BLOCKED_SAFE","actor":"watchdog","guards":["no-safe-recovery"],"effect":"disable-unsafe-operations"}
  ]
}
