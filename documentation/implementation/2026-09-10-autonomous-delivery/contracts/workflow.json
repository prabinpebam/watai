    "spec-pinned","budget-reserved","independent-evidence","gates-passed",
    "adversaries-complete","stage-contract","permit-current","route-reconciled",
    "observation-passed","attempts-remaining","effects-reconciled","budget-remaining",
    "attempts-exhausted","no-public-effects","public-effects-possible",
    "lkg-admissible","rollback-confirmed","authority-missing","no-safe-recovery",
    "integrity-fault","deadline-exceeded","cancel-authorized","cohort-scope",
    "cohort-observation-passed","full-scope","new-single-use-permit"
