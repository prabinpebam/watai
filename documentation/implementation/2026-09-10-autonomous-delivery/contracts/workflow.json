{
  "schemaVersion":"1.0",
  "status":"SPECIFIED",
  "initial":"QUEUED",
  "states":[
    {"id":"QUEUED","terminal":false},
    {"id":"PREFLIGHT","terminal":false},
    {"id":"SPEC_LOCKED","terminal":false},
    {"id":"BUILDING","terminal":false},
    {"id":"VALIDATING","terminal":false},
    {"id":"ADVERSARIAL","terminal":false},
    {"id":"STAGING","terminal":false},
    {"id":"RELEASE_READY","terminal":false},
    {"id":"PROMOTING","terminal":false},
    {"id":"OBSERVING","terminal":false},
    {"id":"EXPANSION_READY","terminal":false},
    {"id":"EXPANDING","terminal":false},
    {"id":"FINAL_OBSERVING","terminal":false},
    {"id":"FAILED","terminal":false},
    {"id":"TIMED_OUT","terminal":false},
    {"id":"CANCEL_REQUESTED","terminal":false},
    {"id":"QUARANTINED","terminal":false},
    {"id":"ROLLING_BACK","terminal":false},
    {"id":"SHIPPED","terminal":true},
    {"id":"REJECTED","terminal":true},
    {"id":"BLOCKED_SAFE","terminal":true},
    {"id":"CANCELLED","terminal":true},
    {"id":"ROLLED_BACK","terminal":true}
