{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://watai.invalid/spec/autonomous-delivery/1.0",
  "title":"Watai planning-only autonomous delivery contracts",
  "type":"object","additionalProperties":false,
  "required":["backlog","policy","workflow","examples"],
  "properties":{
    "backlog":{"$ref":"#/$defs/backlog"},
    "policy":{"$ref":"#/$defs/policy"},
    "workflow":{"$ref":"#/$defs/workflow"},
    "examples":{"$ref":"#/$defs/examples"}
  },
  "$defs":{
    "text":{"type":"string","minLength":1},
    "sha":{"type":"string","pattern":"^[a-f0-9]{40}$"},
    "digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "texts":{"type":"array","items":{"$ref":"#/$defs/text"},"uniqueItems":true},
    "nonemptyTexts":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/text"},"uniqueItems":true},
    "sliceId":{"type":"string","pattern":"^[HES][0-9]{2}$"},
    "gateId":{"type":"string","pattern":"^G[0-9]{2}$"},
    "capability":{"enum":["history.read","local.draft","settings.read","settings.restrict","chat.generate","assets.grant","outbox.transmit","memory.saved","memory.hybrid","memory.review-learning","memory.automatic-learning","chat.temporary"]},
    "capabilities":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/capability"}},
    "findingId":{"type":"string","pattern":"^(MEM|BE|FE|OPS)-[0-9]{2}$"},
    "sliceIds":{"type":"array","items":{"$ref":"#/$defs/sliceId"},"uniqueItems":true},
    "gateIds":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/gateId"},"uniqueItems":true},
    "findingIds":{"type":"array","items":{"$ref":"#/$defs/findingId"},"uniqueItems":true},
    "nonnegative":{"type":"integer","minimum":0},
    "positive":{"type":"integer","minimum":1},
    "version":{"const":"1.0"},
    "status":{"const":"SPECIFIED"},
    "backlog":{
      "type":"object","additionalProperties":false,
      "required":["schemaVersion","status","auditCommit","sourceBaseline","auditRegister","findings","slices"],
      "properties":{
        "schemaVersion":{"$ref":"#/$defs/version"},"status":{"$ref":"#/$defs/status"},
        "auditCommit":{"$ref":"#/$defs/sha"},"sourceBaseline":{"$ref":"#/$defs/sha"},
        "auditRegister":{"$ref":"#/$defs/text"},
        "findings":{"type":"array","minItems":52,"maxItems":52,"items":{
          "type":"object","additionalProperties":false,"required":["id","closureSlices"],
          "properties":{"id":{"$ref":"#/$defs/findingId"},"closureSlices":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/sliceId"}}}
        }},
        "slices":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/slice"}}
      }
    },
    "slice":{
      "type":"object","additionalProperties":false,
      "required":["id","title","milestone","ownerAgent","dependsOn","findings","risk","scope","visibleChange","acceptance","gates","evidence","rollout","rollback"],
      "properties":{
        "id":{"$ref":"#/$defs/sliceId"},"title":{"$ref":"#/$defs/text"},
        "milestone":{"enum":["M0","M1","M2","M3","M4"]},"ownerAgent":{"$ref":"#/$defs/text"},
        "dependsOn":{"$ref":"#/$defs/sliceIds"},"findings":{"$ref":"#/$defs/findingIds"},
        "risk":{"enum":["critical","high","medium"]},"scope":{"$ref":"#/$defs/nonemptyTexts"},
        "visibleChange":{"$ref":"#/$defs/text"},
        "acceptance":{"type":"array","minItems":2,"items":{
          "type":"object","additionalProperties":false,"required":["id","gate","check"],
          "properties":{"id":{"$ref":"#/$defs/text"},"gate":{"$ref":"#/$defs/gateId"},"check":{"$ref":"#/$defs/text"}}
        }},
        "gates":{"$ref":"#/$defs/gateIds"},"evidence":{"$ref":"#/$defs/nonemptyTexts"},
        "rollout":{"type":"object","additionalProperties":false,"required":["profile","steps"],
          "properties":{"profile":{"$ref":"#/$defs/text"},"steps":{"$ref":"#/$defs/nonemptyTexts"}}},
        "rollback":{"$ref":"#/$defs/text"}
      }
    },
    "role":{
      "type":"object","additionalProperties":false,
      "required":["id","canEditCandidate","canAttest","canRelease","canEditPolicy"],
      "properties":{
        "id":{"$ref":"#/$defs/text"},"canEditCandidate":{"type":"boolean"},
        "canAttest":{"type":"boolean"},"canRelease":{"type":"boolean"},"canEditPolicy":{"type":"boolean"}
      }
    },
    "gate":{
      "type":"object","additionalProperties":false,
      "required":["id","kind","name","authority","failure","definition"],
      "properties":{
        "id":{"$ref":"#/$defs/gateId"},"kind":{"enum":["hard","final"]},"name":{"$ref":"#/$defs/text"},
        "authority":{"$ref":"#/$defs/text"},"failure":{"$ref":"#/$defs/text"},"definition":{"$ref":"#/$defs/text"}
      }
    },
    "limits":{
      "type":"object","additionalProperties":false,
      "required":["productWip","builders","promotions","builderAttempts","infrastructureReruns","strategySwitches","backoffSeconds","controllerLeaseSeconds","controllerHeartbeatSeconds","workerLeaseSeconds","workerHeartbeatSeconds","maxClockSkewSeconds","minimumEffectLeaseSeconds","permitTtlSeconds","candidateActiveMinutes","builderAttemptMinutes","validationMinutes","candidateUsd","engineeringDayUsd","evaluationRunUsd","infraMonthUsd","recoveryMonthUsd","candidateInputTokens","candidateOutputTokens","memoryContextTokens","memoryLookupMilliseconds"],
      "properties":{
        "productWip":{"$ref":"#/$defs/positive"},"builders":{"$ref":"#/$defs/positive"},
        "promotions":{"$ref":"#/$defs/positive"},"builderAttempts":{"$ref":"#/$defs/positive"},
        "infrastructureReruns":{"$ref":"#/$defs/nonnegative"},"strategySwitches":{"$ref":"#/$defs/nonnegative"},
        "backoffSeconds":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/positive"}},
        "controllerLeaseSeconds":{"$ref":"#/$defs/positive"},"controllerHeartbeatSeconds":{"$ref":"#/$defs/positive"},
        "workerLeaseSeconds":{"$ref":"#/$defs/positive"},"workerHeartbeatSeconds":{"$ref":"#/$defs/positive"},
        "maxClockSkewSeconds":{"$ref":"#/$defs/nonnegative"},"minimumEffectLeaseSeconds":{"$ref":"#/$defs/positive"},
        "permitTtlSeconds":{"$ref":"#/$defs/positive"},"candidateActiveMinutes":{"$ref":"#/$defs/positive"},
        "builderAttemptMinutes":{"$ref":"#/$defs/positive"},"validationMinutes":{"$ref":"#/$defs/positive"},
        "candidateUsd":{"$ref":"#/$defs/positive"},"engineeringDayUsd":{"$ref":"#/$defs/positive"},
        "evaluationRunUsd":{"$ref":"#/$defs/positive"},"infraMonthUsd":{"$ref":"#/$defs/positive"},
        "recoveryMonthUsd":{"$ref":"#/$defs/positive"},"candidateInputTokens":{"$ref":"#/$defs/positive"},
        "candidateOutputTokens":{"$ref":"#/$defs/positive"},"memoryContextTokens":{"$ref":"#/$defs/positive"},
        "memoryLookupMilliseconds":{"$ref":"#/$defs/positive"}
      }
    },
    "policy":{
      "type":"object","additionalProperties":false,
      "required":["schemaVersion","status","authorizationGranted","effectiveSpendUsd","policyEvolution","roles","mandatoryGates","productMandatoryGates","holdoutPolicy","capabilities","capabilityEnvelopes","gates","limits","protectedPaths","evidenceKinds","rolloutProfiles","blockedPolicy"],
      "properties":{
        "schemaVersion":{"$ref":"#/$defs/version"},"status":{"$ref":"#/$defs/status"},
        "authorizationGranted":{"const":false},"effectiveSpendUsd":{"const":0},
        "policyEvolution":{"const":"independent-old-root"},
        "roles":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/role"}},
        "mandatoryGates":{"$ref":"#/$defs/gateIds"},
        "productMandatoryGates":{"$ref":"#/$defs/gateIds"},
        "capabilities":{"$ref":"#/$defs/capabilities"},
        "capabilityEnvelopes":{"type":"array","minItems":1,"items":{
          "type":"object","additionalProperties":false,
          "required":["id","inherits","allowed","denied","requiredShippedSlices","requiredGates","bootstrapCandidateSubstitutions"],
          "properties":{
            "id":{"$ref":"#/$defs/text"},"inherits":{"$ref":"#/$defs/texts"},
            "allowed":{"$ref":"#/$defs/capabilities"},"denied":{"$ref":"#/$defs/capabilities"},
            "requiredShippedSlices":{"$ref":"#/$defs/sliceIds"},"requiredGates":{"$ref":"#/$defs/gateIds"},
            "bootstrapCandidateSubstitutions":{"$ref":"#/$defs/sliceIds"}
          }
        }},
        "holdoutPolicy":{
          "type":"object","additionalProperties":false,
          "required":["validationMaxExposures","finalMaxExposures","exposurePoint","refundAbortedExposure","authority"],
          "properties":{
            "validationMaxExposures":{"const":3},"finalMaxExposures":{"const":1},
            "exposurePoint":{"const":"atomic-reservation-before-private-data-access"},
            "refundAbortedExposure":{"const":false},"authority":{"const":"evaluator"}
          }
        },
        "gates":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/gate"}},
        "limits":{"$ref":"#/$defs/limits"},
        "protectedPaths":{"$ref":"#/$defs/nonemptyTexts"},
        "evidenceKinds":{"$ref":"#/$defs/nonemptyTexts"},"rolloutProfiles":{"$ref":"#/$defs/nonemptyTexts"},
        "blockedPolicy":{
          "type":"object","additionalProperties":false,
          "required":["humanFallback","weakenGates","inventPermissions","serveCandidate","rollbackRevokedRelease","recheckMaxPerDay","recheckMaxDays","missingEvidence","inconclusiveEvidence","requiredUnsupported"],
          "properties":{
            "humanFallback":{"const":false},"weakenGates":{"const":false},
            "inventPermissions":{"const":false},"serveCandidate":{"const":false},"rollbackRevokedRelease":{"const":false},
            "recheckMaxPerDay":{"$ref":"#/$defs/positive"},"recheckMaxDays":{"$ref":"#/$defs/positive"},
            "missingEvidence":{"const":"FAIL"},"inconclusiveEvidence":{"const":"FAIL"},
            "requiredUnsupported":{"const":"BLOCKED_SAFE"}
          }
        }
      }
    },
    "workflow":{
      "type":"object","additionalProperties":false,
      "required":["schemaVersion","status","initial","states","guards","transitionDefaults","transitions"],
      "properties":{
        "schemaVersion":{"$ref":"#/$defs/version"},"status":{"$ref":"#/$defs/status"},"initial":{"$ref":"#/$defs/text"},
        "states":{"type":"array","minItems":1,"items":{
          "type":"object","additionalProperties":false,"required":["id","terminal"],
          "properties":{"id":{"$ref":"#/$defs/text"},"terminal":{"type":"boolean"}}
        }},
        "guards":{"$ref":"#/$defs/nonemptyTexts"},
        "transitionDefaults":{
          "type":"object","additionalProperties":false,"required":["requiredGuards","commit"],
          "properties":{"requiredGuards":{"$ref":"#/$defs/nonemptyTexts"},"commit":{"const":"candidate-partition-cas-with-event-and-outbox"}}
        },
        "transitions":{"type":"array","minItems":1,"items":{
          "type":"object","additionalProperties":false,"required":["from","event","to","actor","guards","effect"],
          "properties":{
            "from":{"$ref":"#/$defs/nonemptyTexts"},"event":{"$ref":"#/$defs/text"},"to":{"$ref":"#/$defs/text"},
            "actor":{"$ref":"#/$defs/text"},"guards":{"$ref":"#/$defs/nonemptyTexts"},
            "effect":{"enum":["preflight","none","worker","validation","adversaries","stage","promote","expand","observe","cancel-children","backoff","freeze","rollback","disable-unsafe-operations"]}
          }
        }}
      }
    },
    "subject":{
      "type":"object","additionalProperties":false,"required":["id","kind","payload","sha256","parents"],
      "properties":{
        "id":{"$ref":"#/$defs/text"},"kind":{"enum":["source","artifact","configuration","authority","fixture","result","manifest"]},
        "payload":{"$ref":"#/$defs/text"},"sha256":{"$ref":"#/$defs/digest"},
        "parents":{"type":"array","uniqueItems":true,"items":{
          "type":"object","additionalProperties":false,"required":["relation","subject"],
          "properties":{"relation":{"enum":["builtFrom","testedArtifact","evaluatedWith","deployedWith","supersedes","derivedFrom"]},"subject":{"$ref":"#/$defs/text"}}
        }}
      }
    },
    "bindings":{
      "type":"object","additionalProperties":false,
      "required":["source","frontend","api","configuration","infra","dependencies","policy","workflow","evaluator","dataset","prompt","model","environment","dataSchema","toolchain","suite"],
      "properties":{
        "source":{"$ref":"#/$defs/text"},"frontend":{"$ref":"#/$defs/text"},"api":{"$ref":"#/$defs/text"},
        "configuration":{"$ref":"#/$defs/text"},"infra":{"$ref":"#/$defs/text"},"dependencies":{"$ref":"#/$defs/text"},
        "policy":{"$ref":"#/$defs/text"},"workflow":{"$ref":"#/$defs/text"},"evaluator":{"$ref":"#/$defs/text"},
        "dataset":{"$ref":"#/$defs/text"},"prompt":{"$ref":"#/$defs/text"},"model":{"$ref":"#/$defs/text"},
        "environment":{"$ref":"#/$defs/text"},"dataSchema":{"$ref":"#/$defs/text"},"toolchain":{"$ref":"#/$defs/text"},"suite":{"$ref":"#/$defs/text"}
      }
    },
    "check":{
      "type":"object","additionalProperties":false,
      "required":["id","gate","resultSubject","producerRole","producerIdentity","artifactSubjects","expected","attempted","passed","failed","skipped","timedOut"],
      "properties":{
        "id":{"$ref":"#/$defs/text"},"gate":{"$ref":"#/$defs/gateId"},
        "resultSubject":{"$ref":"#/$defs/text"},"producerRole":{"$ref":"#/$defs/text"},"producerIdentity":{"$ref":"#/$defs/text"},
        "artifactSubjects":{"$ref":"#/$defs/nonemptyTexts"},"expected":{"$ref":"#/$defs/positive"},
        "attempted":{"$ref":"#/$defs/nonnegative"},"passed":{"$ref":"#/$defs/nonnegative"},
        "failed":{"$ref":"#/$defs/nonnegative"},"skipped":{"$ref":"#/$defs/nonnegative"},"timedOut":{"$ref":"#/$defs/nonnegative"}
      }
    },
    "examples":{
      "type":"object","additionalProperties":false,
      "required":["schemaVersion","status","synthetic","releaseEligible","note","subjects","exposureLedger","capabilityBinding","rolloutPermits","packet","eventExample","traces"],
      "properties":{
        "schemaVersion":{"$ref":"#/$defs/version"},"status":{"const":"EXAMPLE_ONLY"},"synthetic":{"const":true},"releaseEligible":{"const":false},"note":{"$ref":"#/$defs/text"},
        "subjects":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/subject"}},
        "capabilityBinding":{
          "type":"object","additionalProperties":false,
          "required":["envelopeId","envelopeSha256","configurationSubject","observedCapabilities","shippedSlices","bootstrap","bootstrapCandidateSlices","rollbackEnvelopeId","revokedCapabilities"],
          "properties":{
            "envelopeId":{"$ref":"#/$defs/text"},"envelopeSha256":{"$ref":"#/$defs/digest"},
            "configurationSubject":{"$ref":"#/$defs/text"},"observedCapabilities":{"$ref":"#/$defs/capabilities"},
            "shippedSlices":{"$ref":"#/$defs/sliceIds"},"bootstrap":{"type":"boolean"},"bootstrapCandidateSlices":{"$ref":"#/$defs/sliceIds"},
            "rollbackEnvelopeId":{"$ref":"#/$defs/text"},"revokedCapabilities":{"$ref":"#/$defs/capabilities"}
          }
        },
        "exposureLedger":{
          "type":"object","additionalProperties":false,"required":["authority","banks","reservations"],
          "properties":{
            "authority":{"const":"evaluator"},
            "banks":{"type":"array","minItems":2,"items":{
              "type":"object","additionalProperties":false,"required":["bankId","digest","purpose","precommitId","maxExposures"],
              "properties":{"bankId":{"$ref":"#/$defs/text"},"digest":{"$ref":"#/$defs/digest"},"purpose":{"enum":["validation","final"]},"precommitId":{"$ref":"#/$defs/text"},"maxExposures":{"$ref":"#/$defs/positive"}}
            }},
            "reservations":{"type":"array","minItems":1,"items":{
              "type":"object","additionalProperties":false,"required":["reservationId","bankId","ordinal","sequence","runId","sourceSha","outcome"],
              "properties":{"reservationId":{"$ref":"#/$defs/text"},"bankId":{"$ref":"#/$defs/text"},"ordinal":{"$ref":"#/$defs/positive"},"sequence":{"$ref":"#/$defs/positive"},"runId":{"$ref":"#/$defs/text"},"sourceSha":{"$ref":"#/$defs/sha"},"outcome":{"enum":["failed","aborted","completed"]}}
            }}
          }
        },
        "rolloutPermits":{"type":"array","minItems":2,"items":{
          "type":"object","additionalProperties":false,"required":["permitId","nonce","phase","parentPermitId","scope","fencingEpoch","issuedAt","expiresAt","consumedAt","manifestSha256","envelopeId","envelopeSha256"],
          "properties":{
            "permitId":{"$ref":"#/$defs/text"},"nonce":{"$ref":"#/$defs/text"},"phase":{"enum":["cohort","full"]},
            "parentPermitId":{"$ref":"#/$defs/text"},"scope":{"$ref":"#/$defs/text"},
            "fencingEpoch":{"$ref":"#/$defs/positive"},"issuedAt":{"$ref":"#/$defs/text"},"expiresAt":{"$ref":"#/$defs/text"},"consumedAt":{"$ref":"#/$defs/text"},
            "manifestSha256":{"$ref":"#/$defs/digest"},
            "envelopeId":{"$ref":"#/$defs/text"},"envelopeSha256":{"$ref":"#/$defs/digest"}
          }
        }},
        "packet":{
          "type":"object","additionalProperties":false,
          "required":["runId","sliceId","sourceSha","baseSha","createdAt","expiresAt","fencingEpoch","subjects","secretVersionIds","modelVersion","evaluationReservation","checks","negativeControls","signatures","decision"],
          "properties":{
            "runId":{"$ref":"#/$defs/text"},"sliceId":{"$ref":"#/$defs/sliceId"},
            "sourceSha":{"$ref":"#/$defs/sha"},"baseSha":{"$ref":"#/$defs/sha"},
            "createdAt":{"$ref":"#/$defs/text"},"expiresAt":{"$ref":"#/$defs/text"},"fencingEpoch":{"$ref":"#/$defs/positive"},
            "subjects":{"$ref":"#/$defs/bindings"},"secretVersionIds":{"$ref":"#/$defs/texts"},"modelVersion":{"$ref":"#/$defs/text"},
            "evaluationReservation":{
              "type":"object","additionalProperties":false,
              "required":["bankId","digest","purpose","precommitId","exposureOrdinal","ledgerSequence","reservationId"],
              "properties":{
                "bankId":{"$ref":"#/$defs/text"},"digest":{"$ref":"#/$defs/digest"},
                "purpose":{"enum":["validation","final"]},"precommitId":{"$ref":"#/$defs/text"},
                "exposureOrdinal":{"$ref":"#/$defs/positive"},"ledgerSequence":{"$ref":"#/$defs/positive"},"reservationId":{"$ref":"#/$defs/text"}
              }
            },
            "checks":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/check"}},
            "negativeControls":{"type":"array","minItems":2,"items":{
              "type":"object","additionalProperties":false,"required":["id","gate","expected","observed"],
              "properties":{"id":{"$ref":"#/$defs/text"},"gate":{"$ref":"#/$defs/gateId"},"expected":{"const":"REJECT"},"observed":{"const":"REJECT"}}
            }},
            "signatures":{"type":"array","maxItems":0},
            "decision":{"type":"object","additionalProperties":false,"required":["outcome","reason"],
              "properties":{"outcome":{"const":"DENY"},"reason":{"$ref":"#/$defs/text"}}}
          }
        },
        "eventExample":{
          "type":"object","additionalProperties":false,
          "required":["schemaVersion","runId","eventId","expectedRevision","fencingEpoch","sourceSha","policySha256","eventType","payloadSha256"],
          "properties":{
            "schemaVersion":{"$ref":"#/$defs/version"},"runId":{"$ref":"#/$defs/text"},"eventId":{"$ref":"#/$defs/text"},
            "expectedRevision":{"$ref":"#/$defs/nonnegative"},"fencingEpoch":{"$ref":"#/$defs/positive"},
            "sourceSha":{"$ref":"#/$defs/sha"},"policySha256":{"$ref":"#/$defs/digest"},
            "eventType":{"$ref":"#/$defs/text"},"payloadSha256":{"$ref":"#/$defs/digest"}
          }
        },
        "traces":{"type":"array","minItems":1,"items":{
          "type":"object","additionalProperties":false,"required":["id","start","events","end"],
          "properties":{"id":{"$ref":"#/$defs/text"},"start":{"$ref":"#/$defs/text"},"events":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/text"}},"end":{"$ref":"#/$defs/text"}}
        }}
      }
    }
  }
}
